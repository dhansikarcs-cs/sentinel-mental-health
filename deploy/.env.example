# Copy this file to deploy/.env and fill in. deploy/.env is gitignored.
# Domain you bought at GoDaddy. BARE hostname only: no https://, no slash.
# Caddy uses it as the site address; compose derives https://$DOMAIN for CORS
# and the trustee acknowledgement link.
DOMAIN=sentinelpsytech.com

# REQUIRED. Generate once and keep it forever: openssl rand -hex 32
JWT_SECRET=

# ---- AI (leave blank for now; co-founder can fill later) ----
ALLOW_CLOUD_AI=false
GROQ_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# ---- Crisis email (blank = offline fallback) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
CRISIS_HELPLINE_EMAIL=

# ---- Journal encryption ----
# false for the pilot: the migrated local DB has plaintext journals.
# true only with a FRESH DB + a fixed passphrase AND a fixed salt.
ENCRYPTION_REQUIRED=false
ENCRYPTION_PASSPHRASE=
SENTINEL_ENCRYPTION_SALT=
